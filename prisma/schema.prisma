// HealthTwin — Postgres data model (Neon in production).
//
// Each user has one HealthState row for the parts of their twin that are read
// and written as a whole (onboarding answers, the derived profile, dose log,
// Medical ID), plus one row per record and per reading so those can grow and
// be queried.
//
// Ids from the app (`clientId`) are kept as-is so links between readings and
// records survive; they are unique per user, not globally (sample records use
// the same ids for everyone).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  state    HealthState?
  records  HealthRecord[]
  readings Reading[]
}

model HealthState {
  userId             String   @id
  /// Raw onboarding answers (AnswerValue by question id).
  answers            Json     @default("{}")
  onboardingComplete Boolean  @default(false)
  /// HealthProfile derived from the answers.
  profile            Json?
  sampleSeeded       Boolean  @default(false)
  isDemo             Boolean  @default(false)
  /// ISO date → medication ids marked as taken.
  doseLog            Json     @default("{}")
  /// Medical ID details: blood type, emergency contact, notes.
  emergency          Json     @default("{}")
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthRecord {
  id         String   @id @default(cuid())
  userId     String
  clientId   String
  type       String
  title      String
  date       String
  provider   String?
  fileName   String?
  status     String
  summary    String?
  impression String?
  /// ExtractedValue[]
  values     Json     @default("[]")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, date])
}

model Reading {
  id       String @id @default(cuid())
  userId   String
  clientId String
  metric   String
  value    Float
  unit     String
  takenAt  String
  source   String
  /// clientId of the record this reading came from, if any.
  recordId String?
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, metric, takenAt])
}
